<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks><Optimize>true</Optimize>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="../../Runtime/Core/*.cs" />
    <Reference Include="UnityEngine.MathematicsModule"><HintPath>$(EditorManaged)/UnityEngine.MathematicsModule.dll</HintPath></Reference>
  </ItemGroup>
  <Target Name="CheckEditorPath" BeforeTargets="ResolveReferences" Condition="!Exists('$(EditorManaged)/UnityEngine.MathematicsModule.dll')">
    <Error Text="Supply -p:EditorManaged=/path/to/Unity.app/Contents/Resources/Scripting/Managed/UnityEngine (Unity6.5 installed mathematics module)." />
  </Target>
</Project>
