root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
indent_style = space
indent_size = 4

[*.{json,jsonl,yml,yaml}]
indent_style = space
indent_size = 2

[*.{sh,py,ps1}]
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false

# Matches the eol=crlf rules in .gitattributes, so an editor does not undo them.
[*.{bat,cmd,reg}]
end_of_line = crlf
